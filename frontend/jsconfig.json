{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "strict": false
  },
  "include": ["src", "../backend"],
  "exclude": [
    "node_modules",
    "../backend/node_modules",
    "dist"
  ]
}
